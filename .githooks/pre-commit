#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "${repo_root:-}" ]]; then
  exit 0
fi

deny_file="$repo_root/.githooks/sensitive-paths.txt"
if [[ ! -f "$deny_file" ]]; then
  exit 0
fi

patterns=()
while IFS= read -r raw_line || [[ -n "$raw_line" ]]; do
  line="${raw_line%%#*}"
  line="${line#"${line%%[![:space:]]*}"}"
  line="${line%"${line##*[![:space:]]}"}"
  if [[ -n "$line" ]]; then
    patterns+=("$line")
  fi
done < "$deny_file"

if (( ${#patterns[@]} == 0 )); then
  exit 0
fi

blocked=()
while IFS= read -r -d '' path; do
  for pattern in "${patterns[@]}"; do
    if [[ "$path" == $pattern ]]; then
      blocked+=("$path")
      break
    fi
  done
done < <(git diff --cached --name-only --diff-filter=ACMRTUXB -z)

if (( ${#blocked[@]} == 0 )); then
  exit 0
fi

printf '\n[pre-commit] blocked sensitive file(s) staged for commit:\n' >&2
for path in "${blocked[@]}"; do
  printf '  - %s\n' "$path" >&2
done

printf '\nDenylist: %s\n' "$deny_file" >&2
printf 'Unstage blocked paths, then retry:\n' >&2
for path in "${blocked[@]}"; do
  printf '  git restore --staged -- %q\n' "$path" >&2
done
printf '\n(Override with --no-verify only if you are absolutely sure.)\n' >&2

exit 1
