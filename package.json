{
  "name": "aftk-toolkit",
  "private": true,
  "type": "module",
  "keywords": ["pi-package"],
  "exports": {
    ".": "./src/index.ts",
    "./pi": "./src/hosts/pi/index.ts",
    "./pi-extension": "./src/hosts/pi/extension.ts",
    "./pi-logging-extension": "./src/hosts/pi/logging-extension.ts"
  },
  "pi": {
    "extensions": ["./src/hosts/pi/extension.ts", "./src/hosts/pi/logging-extension.ts"]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test:toolkit:unit": "node --experimental-strip-types --test \"tests/toolkit/**/*.unit.test.ts\"",
    "test:toolkit:integration": "node --experimental-strip-types --test \"tests/toolkit/**/*.integration.test.ts\"",
    "test:toolkit": "npm run test:toolkit:unit && npm run test:toolkit:integration",
    "test:all": "lake test && npm run test:toolkit"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "^5.0.0"
  }
}
